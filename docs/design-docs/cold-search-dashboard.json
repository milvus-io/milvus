{
  "uid": "milvus-cold-search-stages",
  "title": "Milvus cold Search stages",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "milvus",
    "query-view"
  ],
  "timezone": "browser",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus"
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "$DS_PROMETHEUS"
        },
        "query": "label_values(up,instance)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "operation",
        "type": "custom",
        "query": "Search,HybridSearch,Query",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "Search",
          "value": "Search"
        }
      },
      {
        "name": "path",
        "type": "custom",
        "query": "unloaded,loading,ready,disabled,unknown",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "latency_class",
        "type": "custom",
        "query": "le1s,gt1s",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 99,
      "type": "text",
      "title": "Reading boundaries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Start with request cohorts. Only readiness + execution + retry_wait and exclusive flush reasons are additive. Node/view/segment/batch populations differ; do not sum their P99s. Native cache wait, native manifest details, client/SDK and transport attribution remain incomplete. See the accompanying design/validation document."
      }
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request stage mean — same completed cohort",
      "description": "total = readiness + execution + retry_wait for these completed requests. Select gt1s to explain the whole slow cohort. Ready does not mean caches are warm.",
      "datasource": {
        "type": "prometheus",
        "uid": "$DS_PROMETHEUS"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (stage) (rate(milvus_qv_request_stage_duration_seconds_sum{instance=~\"$instance\",operation=~\"$operation\",path=~\"$path\",latency_class=~\"$latency_class\"}[$__rate_interval])) / sum by (stage) (rate(milvus_qv_request_stage_duration_seconds_count{instance=~\"$instance\",operation=~\"$operation\",path=~\"$path\",latency_class=~\"$latency_class\"}[$__rate_interval]))",
          "legendFormat": "{{stage}} {{result}} {{kind}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Logical request P99",
      "description": "Each stage retains its own population; nested stages overlap.",
      "datasource": {
        "type": "prometheus",
        "uid": "$DS_PROMETHEUS"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99,sum by (le) (rate(milvus_qv_request_stage_duration_seconds_bucket{instance=~\"$instance\",operation=~\"$operation\",path=~\"$path\",latency_class=~\"$latency_class\",stage=\"total\"}[$__rate_interval])))",
          "legendFormat": "{{stage}} {{result}} {{kind}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
