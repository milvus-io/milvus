    {
      "id": 7,
      "type": "timeseries",
      "title": "Flush pending reasons — exclusive intervals",
      "description": "Same merged shard cohorts; same_shard_wait + batch_hold + eligible_wait = pending_total apart from recorder overhead. eligible_wait includes NodeScheduler queue.",
      "datasource": {
        "type": "prometheus",
        "uid": "$DS_PROMETHEUS"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (stage) (rate(milvus_qv_stage_duration_seconds_sum{instance=~\"$instance\",component=\"coord\",operation=\"flush\",stage=~\"batch_hold|same_shard_wait|eligible_wait|pending_total\"}[$__rate_interval])) / sum by (stage) (rate(milvus_qv_stage_duration_seconds_count{instance=~\"$instance\",component=\"coord\",operation=\"flush\",stage=~\"batch_hold|same_shard_wait|eligible_wait|pending_total\"}[$__rate_interval]))",
          "legendFormat": "{{stage}} {{result}} {{kind}}",
