{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {
        "name": "multisearch-v305"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "milvus-config",
        "namespace": "multisearch-v305"
      },
      "data": {
        "user.yaml": "etcd:\n  endpoints: etcd:2379\n  rootPath: multisearch-k8s\n  auth:\n    enabled: false\n  use:\n    embed: false\ncommon:\n  storageType: remote\n  security:\n    authorizationEnabled: true\nminio:\n  address: minio\n  port: 9000\n  accessKeyID: minioadmin\n  secretAccessKey: minioadmin\n  bucketName: multisearch-v305\n  useSSL: false\nmq:\n  type: woodpecker\nwoodpecker:\n  storage:\n    type: minio\nrootCoord:\n  dmlChannelNum: 4\nlog:\n  level: warn\nquotaAndLimits:\n  dql:\n    enabled: true\nproxy:\n  multiSearch:\n    maxItems: 128\n    parallelism: 16\n    globalParallelism: 64\n    maxBatches: 8\n    maxRequestBytes: 4194304\n    maxResponseBytes: 16777216\n    timeoutSeconds: 30\n"
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "etcd",
        "namespace": "multisearch-v305"
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app": "etcd"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "etcd"
            }
          },
          "spec": {
            "enableServiceLinks": false,
            "securityContext": {
              "fsGroup": 1000
            },
            "containers": [
              {
                "name": "etcd",
                "image": "quay.io/coreos/etcd:v3.5.25",
                "imagePullPolicy": "IfNotPresent",
                "command": [
                  "etcd",
                  "--data-dir=/data/etcd",
                  "--advertise-client-urls=http://etcd:2379",
                  "--listen-client-urls=http://0.0.0.0:2379",
                  "--quota-backend-bytes=4294967296"
                ],
                "resources": {
                  "requests": {
                    "cpu": "500m",
                    "memory": "512Mi"
                  },
                  "limits": {
                    "cpu": "1",
                    "memory": "1Gi"
                  }
                },
                "volumeMounts": [
                  {
                    "name": "data",
                    "mountPath": "/data"
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "data",
                "emptyDir": {}
              }
            ],
            "terminationGracePeriodSeconds": 30
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
