+    def multi_search(
+        self,
+        searches: List[dict],
+        max_concurrent_searches: int = 0,
+        timeout: Optional[float] = None,
+        **kwargs,
+    ) -> List[dict]:
+        """Batch independent search() arguments across databases and collections.
+
+        Each dictionary accepts search() arguments plus id and db_name. The returned
+        ordered dictionaries contain id, result, error, and the original Milvus status.
+        Item failures are returned individually. Transport/envelope failures raise.
+        """
+        prepared = []
+        for source in searches:
+            args = dict(source)
+            validate_param("collection_name", args.get("collection_name"), str)
+            data = args.get("data")
+            if isinstance(data, list) and data and isinstance(data[0], EmbeddingList):
+                args["data"] = [emb.to_flat_array() for emb in data]
+                args["is_embedding_list"] = True
+            args["anns_field"] = args.get("anns_field") or ""
+            args["param"] = args.pop("search_params", None) or {}
+            args["expression"] = args.pop("filter", "")
+            args["expr_params"] = args.pop("filter_params", {})
+            args.setdefault("limit", 10)
+            args.setdefault("db_name", self._config.db_name)
+            prepared.append(self._with_cluster_id(args))
+        return self._get_connection().multi_search(
+            prepared,
+            max_concurrent_searches=max_concurrent_searches,
+            timeout=timeout,
+            context=self._generate_call_context(**kwargs),
+        )
+
     def query(
         self,
         collection_name: str,
