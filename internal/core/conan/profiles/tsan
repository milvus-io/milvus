# Overlay for native host dependencies. Keep build tools on the normal profile.
include(default)

[conf]
user.milvus:sanitizer=thread
user.milvus:tsan_dependency_policy=2
tools.build:cflags=["-fsanitize=thread", "-g", "-fno-omit-frame-pointer"]
tools.build:cxxflags=["-fsanitize=thread", "-g", "-fno-omit-frame-pointer"]
tools.build:exelinkflags=["-fsanitize=thread"]
tools.build:sharedlinkflags=["-fsanitize=thread"]
# Flags alone do not change a Conan package ID. Never reuse ordinary binaries.
tools.info.package_id:confs=["user.milvus:sanitizer", "user.milvus:tsan_dependency_policy", "tools.build:cflags", "tools.build:cxxflags", "tools.build:exelinkflags", "tools.build:sharedlinkflags"]
