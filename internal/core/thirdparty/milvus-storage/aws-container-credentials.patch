From 0e4f6c4a1f3b9d2e5c7a8b0d1e2f3a4b5c6d7e8f Mon Sep 17 00:00:00 2001
From: Milvus <milvus@zilliz.com>
Date: Mon, 9 Nov 2026 00:00:00 +0000
Subject: [PATCH] fix: add container credentials to the AWS provider chain

EKS Pod Identity and ECS task roles deliver credentials only through the
container credentials provider. Add it after Web Identity so useIAM keeps
working on those deployments. The provider is inert unless the
AWS_CONTAINER_CREDENTIALS_* variables are injected, so it does not restore
an implicit node-level fallback.
---
 cpp/include/milvus-storage/filesystem/s3/s3_filesystem_producer.h | 10 +++++-----
 cpp/src/filesystem/s3/s3_filesystem_producer.cpp                  | 25 +++++++++++++++++++++++++
 2 files changed, 30 insertions(+), 5 deletions(-)

diff --git a/cpp/include/milvus-storage/filesystem/s3/s3_filesystem_producer.h b/cpp/include/milvus-storage/filesystem/s3/s3_filesystem_producer.h
index de3e10b..c36205d 100644
--- a/cpp/include/milvus-storage/filesystem/s3/s3_filesystem_producer.h
+++ b/cpp/include/milvus-storage/filesystem/s3/s3_filesystem_producer.h
@@ -25,24 +25,26 @@
 #include "milvus-storage/filesystem/fs.h"
 #include "milvus-storage/filesystem/s3/s3_filesystem.h"
 #include "milvus-storage/filesystem/s3/s3_options.h"
 
 namespace milvus_storage {
 
 /// Shared AWS credential-source policy for storage filesystems and external
 /// callers such as Milvus ChunkManager.
 ///
 /// Initial lookup order: environment AK/SK (with an optional session token),
-/// then STS Web Identity (IRSA). EC2 instance-profile credentials are added last
-/// only when AWS_EC2_METADATA_ENABLE equals "true", ignoring case, at construction.
-/// No profile, SSO, or container credential providers are added. With EC2 enabled,
-/// an IRSA failure can fall back to the Node Role, which the SDK chain may cache.
+/// then STS Web Identity (IRSA), then container credentials (ECS task role or
+/// EKS Pod Identity, active only when the AWS_CONTAINER_CREDENTIALS_* variables
+/// are injected). EC2 instance-profile credentials are added last only when
+/// AWS_EC2_METADATA_ENABLE equals "true", ignoring case, at construction.
+/// No profile or SSO credential providers are added. With EC2 enabled, an IRSA
+/// failure can fall back to the Node Role, which the SDK chain may cache.
 /// Construct and destroy this provider within the initialized AWS SDK lifetime.
 class AwsCredentialsProviderChain final : public Aws::Auth::AWSCredentialsProviderChain {
   public:
   AwsCredentialsProviderChain();
 };
 
 class S3FileSystemProducer : public FileSystemProducer {
   public:
   S3FileSystemProducer(const ArrowFileSystemConfig& config) : config_(config) {}
 
diff --git a/cpp/src/filesystem/s3/s3_filesystem_producer.cpp b/cpp/src/filesystem/s3/s3_filesystem_producer.cpp
index 0643c6a..7c2df10 100644
--- a/cpp/src/filesystem/s3/s3_filesystem_producer.cpp
+++ b/cpp/src/filesystem/s3/s3_filesystem_producer.cpp
@@ -15,20 +15,21 @@
 #include "milvus-storage/filesystem/s3/s3_filesystem_producer.h"
 #include "milvus-storage/common/log.h"
 #include "milvus-storage/filesystem/fs.h"
 
 #include <cstdlib>
 #include <mutex>
 #include <sstream>
 #include <utility>
 
 #include <aws/core/auth/AWSCredentials.h>
+#include <aws/core/auth/GeneralHTTPCredentialsProvider.h>
 #include <aws/core/auth/STSCredentialsProvider.h>
 #include <aws/core/http/HttpClientFactory.h>
 #include <aws/core/http/standard/StandardHttpRequest.h>
 #include <aws/core/platform/Environment.h>
 #include <aws/core/utils/StringUtils.h>
 #include <aws/core/utils/logging/ConsoleLogSystem.h>
 #include <aws/s3/model/CreateBucketRequest.h>
 #include <aws/s3/model/DeleteBucketRequest.h>
 #include <aws/s3/model/DeleteObjectRequest.h>
 #include <aws/s3/model/GetObjectRequest.h>
@@ -103,20 +104,40 @@ class TlsHttpClientFactory : public Aws::Http::HttpClientFactory {
   private:
   std::string tls_min_version_;
 };
 
 }  // namespace
 
 AwsCredentialsProviderChain::AwsCredentialsProviderChain() {
   AddProvider(std::make_shared<Aws::Auth::EnvironmentAWSCredentialsProvider>());
   AddProvider(std::make_shared<Aws::Auth::STSAssumeRoleWebIdentityCredentialsProvider>());
 
+  // Container credentials (ECS task role / EKS Pod Identity). The provider is
+  // active only when the AWS_CONTAINER_CREDENTIALS_* variables are injected, so
+  // unlike the EC2 instance profile it is not an implicit node-level fallback.
+  const auto container_relative_uri = Aws::Environment::GetEnv(
+      Aws::Auth::GeneralHTTPCredentialsProvider::AWS_CONTAINER_CREDENTIALS_RELATIVE_URI);
+  const auto container_full_uri = Aws::Environment::GetEnv(
+      Aws::Auth::GeneralHTTPCredentialsProvider::AWS_CONTAINER_CREDENTIALS_FULL_URI);
+  if (!container_relative_uri.empty() || !container_full_uri.empty()) {
+    const auto container_token = Aws::Environment::GetEnv(
+        Aws::Auth::GeneralHTTPCredentialsProvider::AWS_CONTAINER_AUTHORIZATION_TOKEN);
+    const auto container_token_file = Aws::Environment::GetEnv(
+        Aws::Auth::GeneralHTTPCredentialsProvider::AWS_CONTAINER_AUTHORIZATION_TOKEN_FILE);
+    auto container_credentials =
+        Aws::MakeShared<Aws::Auth::GeneralHTTPCredentialsProvider>("AwsCredentialsProviderChain", container_relative_uri,
+                                                                  container_full_uri, container_token, container_token_file);
+    if (container_credentials && container_credentials->IsValid()) {
+      AddProvider(std::move(container_credentials));
+    }
+  }
+
   // Keep Node Role fallback opt-in: the SDK may cache it after an IRSA failure.
   const auto metadata_enabled = Aws::Environment::GetEnv("AWS_EC2_METADATA_ENABLE");
   if (Aws::Utils::StringUtils::ToLower(metadata_enabled.c_str()) == "true") {
     AddProvider(std::make_shared<Aws::Auth::InstanceProfileCredentialsProvider>());
   }
 }
 
 static std::unordered_map<std::string, S3LogLevel> LogLevel_Map = {
     {"off", S3LogLevel::Off},   {"fatal", S3LogLevel::Fatal}, {"error", S3LogLevel::Error}, {"warn", S3LogLevel::Warn},
     {"info", S3LogLevel::Info}, {"debug", S3LogLevel::Debug}, {"trace", S3LogLevel::Trace}};
