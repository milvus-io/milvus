    {"name": "scale_zero_integer", "literal": "12345", "precision": 18, "scale": 0, "unscaled": 12345, "bytes_le_hex": "3930000000000000"},
    {"name": "max_precision_18", "literal": "999999999999999999", "precision": 18, "scale": 0, "unscaled": 999999999999999999, "bytes_le_hex": "ffff63a7b3b6e00d"},
    {"name": "min_precision_18", "literal": "-999999999999999999", "precision": 18, "scale": 0, "unscaled": -999999999999999999, "bytes_le_hex": "01009c584c491ff2"},
    {"name": "trailing_zero_padding", "literal": "19.9", "precision": 18, "scale": 4, "unscaled": 199000, "bytes_le_hex": "5809030000000000"},
