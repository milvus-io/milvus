config_diagnostics = 1
openssl_conf = openssl_init

# This file is checked in. The included fipsmodule-strict.cnf is generated by
# scripts/build_fips_provider.sh for MILVUS_FIPS_STRICT=ON builds.
.include /milvus/configs/ssl/fipsmodule-strict.cnf

[openssl_init]
providers = provider_sect
alg_section = algorithm_sect
ssl_conf = ssl_sect

# base supplies encoders and decoders only. Unlike openssl-fips.cnf, the default
# provider is not loaded, so non-approved algorithms are not available at all.
[provider_sect]
fips = fips_sect
base = base_sect

[fips_sect]
activate = 1

[base_sect]
activate = 1

[algorithm_sect]
default_properties = fips=yes

# TLS defaults for every SSL_CTX that uses the system defaults. A strict build
# loads only this file, not the system openssl.cnf (see openssl_enabled.go).
# The 3.1.2 FIPS provider registers X25519 and X448 with fips=yes, but its
# Security Policy does not allow them in approved mode, so key exchange is
# limited to NIST curves. Libraries that set their own groups, or that use
# their own TLS stack (s2n), are not covered by this section.
[ssl_sect]
system_default = system_default_sect

[system_default_sect]
MinProtocol = TLSv1.2
CipherString = DEFAULT:@SECLEVEL=2
Groups = P-256:P-384:P-521
