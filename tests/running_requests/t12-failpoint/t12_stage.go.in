package reqregistry

import (
	"context"
	"encoding/json"
	"os"
	"regexp"
	"time"

	"github.com/cockroachdb/errors"
	"github.com/pingcap/failpoint"
)

var t12Collection = regexp.MustCompile(`^running_requests_l1_[0-9a-f]{32}$`)

var ErrT12Retry = errors.New("T12 test checkpoint: retry first search attempt")

type t12Event struct {
	RequestID string  `json:"request_id"`
	TaskID    int64   `json:"task_id"`
	TaskIDs   []int64 `json:"task_ids"`
	Canceled  bool    `json:"canceled"`
}

func writeT12Event(path string, event t12Event) bool {
	data, err := json.Marshal(event)
	if err != nil {
		return false
	}
	if err := os.WriteFile(path+".tmp", data, 0600); err != nil {
		return false
	}
	return os.Rename(path+".tmp", path) == nil
}

// T12TestStage pauses a registered Proxy task at its execution boundary.
func T12TestStage(ctx context.Context, path string, taskID int64) error {
	if _, err := failpoint.Eval("github.com/milvus-io/milvus/internal/proxy/reqregistry/t12InternalStage"); err != nil {
		return nil
	}
	entry := FromContext(ctx)
	if entry == nil {
		return nil
	}
	info := entry.Snapshot(time.Now())
	if info.Type != TypeSearch || (path == "retry" && info.NQ != 2) || !t12Collection.MatchString(info.CollectionName) {
		return nil
	}
	gate := "/tmp/milvus-rr-t12-" + path + "-" + info.CollectionName
	if _, err := os.Stat(gate + ".armed"); err != nil {
		return nil
	}
	event := t12Event{RequestID: info.RequestID, TaskID: taskID, TaskIDs: info.TaskIDs}

	if path == "retry" {
		if _, err := os.Stat(gate + ".retry"); os.IsNotExist(err) {
			if writeT12Event(gate+".retry", event) {
				return ErrT12Retry
			}
			return nil
		}
	}
	if _, err := os.Stat(gate + ".during"); err == nil {
		writeT12Event(gate+".unexpected", event)
		return nil
	}
	if !writeT12Event(gate+".before", event) {
		return nil
	}
	deadline := time.NewTimer(45 * time.Second)
	defer deadline.Stop()
	ticker := time.NewTicker(50 * time.Millisecond)
	defer ticker.Stop()
	for {
		select {
		case <-ctx.Done():
			return context.Cause(ctx)
		case <-deadline.C:
			return nil
		case <-ticker.C:
			if _, err := os.Stat(gate + ".armed"); err != nil {
				return nil
			}
			if _, err := os.Stat(gate + ".advance"); err == nil {
				if !writeT12Event(gate+".during", event) {
					return nil
				}
				for {
					select {
					case <-ctx.Done():
						event.Canceled = CancelCause(ctx) != nil
						writeT12Event(gate+".exit", event)
						return context.Cause(ctx)
					case <-deadline.C:
						return nil
					case <-ticker.C:
						if _, err := os.Stat(gate + ".armed"); err != nil {
							return nil
						}
					}
				}
			}
		}
	}
}
