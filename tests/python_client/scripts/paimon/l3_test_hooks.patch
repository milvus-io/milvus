+
+package paimone2ehook
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/milvus-io/milvus/pkg/v3/util/merr"
+)
+
+func prepare(t *testing.T, kind, phase string) string {
+	t.Helper()
+	previous := hookDirectory
+	hookDirectory = t.TempDir()
+	t.Cleanup(func() { hookDirectory = previous })
+	data, err := json.Marshal(Gate{Lease: "0123456789abcdef0123456789abcdef", CollectionID: 41, SnapshotID: 4, Phase: phase, FieldName: "embedding", IndexName: "embedding"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	name := filepath.Join(hookDirectory, kind+"-"+strconv.Itoa(41))
+	if err := os.WriteFile(name, data, 0600); err != nil {
+		t.Fatal(err)
+	}
+	return name
+}
+
+func TestApplyGateScopesCollectionAndSnapshot(t *testing.T) {
+	prepare(t, "apply", "before-apply")
+	if !HoldApply(1, 41, `{"snapshot_id":"4"}`) {
+		t.Fatal("matching apply was not gated")
+	}
+	if HoldApply(2, 42, `{"snapshot_id":"4"}`) {
+		t.Fatal("gated another collection")
+	}
+	if HoldApply(3, 41, `{"snapshot_id":2}`) {
+		t.Fatal("gated another snapshot")
+	}
+	if err := WaitIndex(context.Background(), task(41, 1, 1)); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestIndexGateUnblocksWithoutCancellingBuild(t *testing.T) {
+	name := prepare(t, "index", "after-apply")
+	done := make(chan error, 1)
+	go func() { done <- WaitIndex(context.Background(), task(41, 11, 22)) }()
+	deadline := time.Now().Add(2 * time.Second)
+	for {
+		events, err := filepath.Glob(filepath.Join(hookDirectory, "seen-index-*"))
+		if err != nil {
+			t.Fatal(err)
+		}
+		if len(events) > 0 {
+			data, err := os.ReadFile(events[0])
+			if err != nil {
+				t.Fatal(err)
+			}
+			var observed event
+			if err := json.Unmarshal(data, &observed); err != nil {
+				t.Fatalf("published incomplete event: %v", err)
+			}
+			if observed.TargetSnapshotID != 4 || observed.TaskSnapshotID == nil || *observed.TaskSnapshotID != 2 || observed.Manifest != "manifest-s2" || observed.FieldID != 100 || observed.IndexID != 101 {
+				t.Fatalf("event did not report actual task identity: %+v", observed)
+			}
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatal("index never reached the gate")
+		}
+		time.Sleep(time.Millisecond)
+	}
+	select {
+	case err := <-done:
+		t.Fatalf("gate released before removal: %v", err)
+	default:
+	}
+	if err := os.Remove(name); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case err := <-done:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("build did not resume")
+	}
+}
+
+func TestIndexGatePreservesCancellation(t *testing.T) {
+	prepare(t, "index", "after-apply")
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if err := WaitIndex(ctx, task(41, 1, 2)); !errors.Is(err, context.Canceled) {
+		t.Fatalf("got %v", err)
+	}
+	if err := WaitIndex(context.Background(), task(42, 1, 2)); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestMalformedTestGateIsAnInternalFailure(t *testing.T) {
+	prepare(t, "index", "unknown-test-phase")
+	if err := WaitIndex(context.Background(), task(41, 1, 2)); !errors.Is(err, merr.ErrServiceInternal) {
+		t.Fatalf("invalid test harness state must not become a user parameter error: %v", err)
+	}
+}
+
+func task(collection, segment, build int64) IndexTask {
+	return IndexTask{CollectionID: collection, SegmentID: segment, BuildID: build, FieldID: 100, IndexID: 101, FieldName: "embedding", IndexName: "embedding", Manifest: "manifest-s2", ExternalSpec: `{"snapshot_id":"2"}`}
+}
+
+func TestIndexGateScopesFieldAndIndex(t *testing.T) {
+	prepare(t, "index", "after-apply")
+	for _, selector := range []string{"field", "index"} {
+		request := task(41, 1, 2)
+		if selector == "field" {
+			request.FieldName = "other"
+		} else {
+			request.IndexName = "other"
+		}
+		ctx, cancel := context.WithCancel(context.Background())
+		cancel()
+		if err := WaitIndex(ctx, request); err != nil {
+			t.Fatalf("held an unrelated %s: %v", selector, err)
+		}
+	}
+	events, _ := filepath.Glob(filepath.Join(hookDirectory, "seen-index-*"))
+	if len(events) != 0 {
+		t.Fatal("recorded unrelated tasks")
+	}
+}
+
+func TestEventPublicationIsAtomic(t *testing.T) {
+	prepare(t, "index", "after-apply")
+	value := event{Lease: "0123456789abcdef0123456789abcdef", Manifest: strings.Repeat("manifest", 300000)}
+	done := make(chan error, 1)
+	go func() { done <- record("index", value) }()
+	deadline := time.Now().Add(2 * time.Second)
+	for {
+		names, _ := filepath.Glob(filepath.Join(hookDirectory, "seen-index-*"))
+		if len(names) != 0 {
+			data, err := os.ReadFile(names[0])
+			var observed event
+			if err != nil || json.Unmarshal(data, &observed) != nil || observed.Manifest != value.Manifest {
+				t.Fatal("reader observed a partially written event")
+			}
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatal("event was never published")
+		}
+		time.Sleep(time.Millisecond)
+	}
+	if err := <-done; err != nil {
+		t.Fatal(err)
+	}
+}
