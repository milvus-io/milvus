+// Test-image-only hooks. This file is delivered as an opt-in patch, never as a
+// production change or part of the L0/L1/L2 image.
+package paimone2ehook
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/milvus-io/milvus/pkg/v3/util/merr"
+)
+
+const Directory = "/tmp/milvus-paimon-e2e-hooks"
+
+var hookDirectory = Directory
+
+type Gate struct {
+	Lease        string `json:"lease"`
+	CollectionID int64  `json:"collection_id"`
+	SnapshotID   int64  `json:"snapshot_id"`
+	Phase        string `json:"phase"`
+	FieldName    string `json:"field_name"`
+	IndexName    string `json:"index_name"`
+}
+
+type event struct {
+	Lease            string `json:"lease"`
+	CollectionID     int64  `json:"collection_id"`
+	TargetSnapshotID int64  `json:"target_snapshot_id"`
+	TaskSnapshotID   *int64 `json:"task_spec_snapshot_id,omitempty"`
+	Phase            string `json:"phase"`
+	JobID            int64  `json:"job_id,omitempty"`
+	SegmentID        int64  `json:"segment_id,omitempty"`
+	BuildID          int64  `json:"build_id,omitempty"`
+	FieldID          int64  `json:"field_id,omitempty"`
+	IndexID          int64  `json:"index_id,omitempty"`
+	FieldName        string `json:"field_name,omitempty"`
+	IndexName        string `json:"index_name,omitempty"`
+	Manifest         string `json:"manifest_path,omitempty"`
+	ObservedAt       int64  `json:"observed_at"`
+}
+
+type IndexTask struct {
+	CollectionID, SegmentID, BuildID, FieldID, IndexID int64
+	FieldName, IndexName, Manifest, ExternalSpec       string
+}
+
+func newEvent(value Gate) event {
+	return event{Lease: value.Lease, CollectionID: value.CollectionID, TargetSnapshotID: value.SnapshotID,
+		Phase: value.Phase, ObservedAt: time.Now().UnixMilli()}
+}
+
+func snapshotID(spec string) *int64 {
+	var decoded struct {
+		SnapshotID json.RawMessage `json:"snapshot_id"`
+	}
+	if json.Unmarshal([]byte(spec), &decoded) != nil {
+		return nil
+	}
+	parsed, err := strconv.ParseInt(strings.Trim(string(decoded.SnapshotID), `"`), 10, 64)
+	if err != nil {
+		return nil
+	}
+	return &parsed
+}
+
+func init() {
+	if err := os.MkdirAll(Directory, 0700); err != nil {
+		panic(err)
+	}
+	if err := os.WriteFile(filepath.Join(Directory, "ready.json"), []byte(`{"protocol":1,"source_commit":"4f95cb61","test_image_only":true}`), 0600); err != nil {
+		panic(err)
+	}
+}
+
+func gate(kind string, collectionID int64) (*Gate, error) {
+	data, err := os.ReadFile(filepath.Join(hookDirectory, kind+"-"+strconv.FormatInt(collectionID, 10)))
+	if os.IsNotExist(err) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	var value Gate
+	if err := json.Unmarshal(data, &value); err != nil {
+		return nil, err
+	}
+	if value.CollectionID != collectionID || collectionID <= 0 || value.SnapshotID < 0 || len(value.Lease) != 32 || strings.ContainsAny(value.Lease, "/\\.") {
+		return nil, merr.WrapErrServiceInternalMsg("invalid Paimon test gate")
+	}
+	return &value, nil
+}
+
+func record(kind string, value event) error {
+	key := fmt.Sprintf("seen-%s-%s-%d-%d-%d", kind, value.Lease, value.JobID, value.SegmentID, value.BuildID)
+	final := filepath.Join(hookDirectory, key)
+	if _, err := os.Stat(final); err == nil {
+		return nil
+	} else if !os.IsNotExist(err) {
+		return err
+	}
+	file, err := os.CreateTemp(hookDirectory, ".writing-event-")
+	if err != nil {
+		return err
+	}
+	defer os.Remove(file.Name())
+	if err := json.NewEncoder(file).Encode(value); err != nil {
+		file.Close()
+		return err
+	}
+	if err := file.Close(); err != nil {
+		return err
+	}
+	// Link publishes complete bytes atomically and never overwrites a prior event.
+	if err := os.Link(file.Name(), final); err != nil && !os.IsExist(err) {
+		return err
+	}
+	return nil
+}
+
+// HoldApply returns to the caller rather than blocking its checker goroutine.
+// The normal checker still advances the job's timeout state on every tick.
+func HoldApply(jobID, collectionID int64, spec string) bool {
+	value, err := gate("apply", collectionID)
+	if err != nil || value == nil || value.Phase != "before-apply" {
+		return false
+	}
+	snapshot := snapshotID(spec)
+	if snapshot == nil || *snapshot != value.SnapshotID {
+		return false
+	}
+	observed := newEvent(*value)
+	observed.JobID, observed.TaskSnapshotID = jobID, snapshot
+	return record("apply", observed) == nil
+}
+
+// WaitIndex holds only this collection's newly executing index tasks. The
+// dedicated driver arms it after every S1 index has genuinely completed.
+func WaitIndex(ctx context.Context, task IndexTask) error {
+	for {
+		value, err := gate("index", task.CollectionID)
+		if err != nil {
+			return err
+		}
+		if value == nil {
+			return nil
+		}
+		if value.Phase != "after-apply" && value.Phase != "wait-disabled" {
+			return merr.WrapErrServiceInternalMsg("invalid Paimon index gate phase")
+		}
+		if value.FieldName == "" || value.IndexName == "" {
+			return merr.WrapErrServiceInternalMsg("Paimon test gate must select a field and index")
+		}
+		if task.FieldName != value.FieldName || task.IndexName != value.IndexName {
+			return nil
+		}
+		observed := newEvent(*value)
+		observed.SegmentID, observed.BuildID = task.SegmentID, task.BuildID
+		observed.FieldID, observed.IndexID = task.FieldID, task.IndexID
+		observed.FieldName, observed.IndexName, observed.Manifest = task.FieldName, task.IndexName, task.Manifest
+		// The collection spec can predate segment publication; the driver binds
+		// actual task manifest/segment to S2 and never treats this as its pin.
+		observed.TaskSnapshotID = snapshotID(task.ExternalSpec)
+		if err := record("index", observed); err != nil {
+			return err
+		}
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		case <-time.After(100 * time.Millisecond):
+		}
+	}
+}
